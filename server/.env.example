PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=teachOSDB
FIREBASE_PROJECT_ID=your-firebase-project-id
# For admin staff provisioning, set this JSON or GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=

# Stripe Checkout. Use a test secret key and test webhook secret for development.
# STRIPE_MODE: test | live
STRIPE_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional Google Meet integration.
GOOGLE_MEET_CLIENT_ID=
GOOGLE_MEET_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=http://localhost:5000/api/course-management/google-meet/callback
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
GOOGLE_MEET_TOKEN_ENCRYPTION_KEY=
